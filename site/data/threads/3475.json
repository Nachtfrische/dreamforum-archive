ls":[]},{"postID":45732,"threadID":3475,"userID":1952,"username":"Senpai","subject":"","time":1459617818,"lastEditTime":0,"editCount":0,"editReason":null,"attachments":[],"cumulativeLikes":0,"editorID":null,"editor":"","likes":[],"bodyHtml":"<blockquote class=\"archive-quote\"><cite>Zitat von <strong>Sky</strong></cite><p>Wurde geprüft und Glumanda ist wirklich schwarz texturiert, für mich jedoch komischerweiße nicht.Die anderen Items/Pokemons funktionieren einwandfrie. Beim nächsten Update wird Glumanda gefixxt.<br></p></blockquote><p>Nicht fixen es ist shiny</p>","polls":[]},{"postID":45764,"threadID":3475,"userID":2156,"username":"Baumi","subject":"","time":1459772416,"lastEditTime":0,"editCount":0,"editReason":null,"attachments":[],"cumulativeLikes":1,"editorID":null,"editor":"","likes":[{"userID":1825,"username":"Nachtfrische","time":1459776031,"value":1}],"bodyHtml":"<p>*Flegmon</p>","polls":[]},{"postID":45766,"threadID":3475,"userID":1602,"username":"FABI / RIZAY","subject":"","time":1459778305,"lastEditTime":0,"editCount":0,"editReason":null,"attachments":[],"cumulativeLikes":-1,"editorID":null,"editor":"","likes":[{"userID":2165,"username":"Makaveli1967","time":1459788219,"value":-1}],"bodyHtml":"<p>Gleich donaten xD</p>\n<p><br></p>\n<p><br></p>\n<p>#Pikachu</p>\n<p><br></p>\n<p><br></p>\n<p><br></p>\n<p><br></p>\n<p><br></p>\n<p>LOVE <span class=\"missing-media\">[dream*]</span></p>","polls":[]}]}