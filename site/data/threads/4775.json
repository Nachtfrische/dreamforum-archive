lativeLikes":3,"editorID":null,"editor":"","likes":[{"userID":2404,"username":"Mas0n","time":1505843423,"value":1},{"userID":2607,"username":"SkuLz","time":1505855099,"value":1},{"userID":1825,"username":"Nachtfrische","time":1505875737,"value":1}],"bodyHtml":"<p>Congratz to my colleagues. I just want to say, that  I know this has been a bit controverse and not everybody was happy with this. If there is a person like this (I know there are some) please say your opinion here so we know what to improve and what is not right in your opinion. I would personally appretiate it and if you will keep it civil, I won&#x27;t get mad. Once again thanks and congratz.</p>","polls":[]},{"postID":72067,"threadID":4775,"userID":2043,"username":"ApudoX","subject":"","time":1505843257,"lastEditTime":0,"editCount":0,"editReason":null,"attachments":[],"cumulativeLikes":2,"editorID":null,"editor":"","likes":[{"userID":2404,"username":"Mas0n","time":1505843421,"value":1},{"userID":2607,"username":"SkuLz","time":1505855094,"value":1}],"bodyHtml":"<p>Vielen Dank  <span class=\"archive-emoji\">😇</span></p>","polls":[]},{"postID":72068,"threadID":4775,"userID":1153,"username":"Schockly","subject":"","time":1505843261,"lastEditTime":0,"editCount":0,"editReason":null,"attachments":[],"cumulativeLikes":0,"editorID":null,"editor":"","likes":[{"userID":2404,"username":"Mas0n","time":1505843422,"value":1},{"userID":2753,"username":"GorillaMann","time":1506792725,"value":-1}],"bodyHtml":"<p>gz an alle <span class=\"archive-emoji\">🙂</span></p>","polls":[]},{"postID":72069,"threadID":4775,"userID":8,"username":"laduck","subject":"","time":1505844574,"lastEditTime":0,"editCount":0,"editReason":null,"attachments":[],"cumulativeLikes":1,"editorID":null,"editor":"","likes":[{"userID":2404,"username":"Mas0n","time":1505845025,"value":1}],"bodyHtml":"<p>Gratz @all <span class=\"archive-emoji\">🙂</span></p>","polls":[]},{"postID":72070,"threadID":4775,"userID":2369,"username":"Luckiris","subject":"","time":